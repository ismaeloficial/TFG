# Cadena de conexion a Supabase (Postgres). Sacala de:
# Supabase > boton "Connect" (arriba del panel) > Direct Connection > tipo URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Broker MQTT (en local, el de docker-compose.yml)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_EVENTS=trazabilidad/eventos
